---
import { contact, profile, site } from "../config/site.ts";
import AboutSection from "../features/about/AboutSection.astro";
import ContactSection from "../features/contact/ContactSection.astro";
import SiteFooter from "../features/footer/SiteFooter.astro";
import SiteHeader from "../features/header/SiteHeader.astro";
import HeroPreload from "../features/hero/HeroPreload.astro";
import HeroSection from "../features/hero/HeroSection.astro";
import ProjectsSection from "../features/projects/ProjectsSection.astro";
import StackSection from "../features/stack/StackSection.astro";
import Layout from "../layouts/Layout.astro";

const siteUrl = Astro.site?.toString() ?? site.url;
const pageUrl = new URL("/", siteUrl).toString();
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@id": `${pageUrl}#person`,
			"@type": "Person",
			description: profile.summary,
			image: new URL(profile.avatar.src, siteUrl).toString(),
			jobTitle: profile.role,
			knowsAbout: profile.knowsAbout,
			name: profile.name,
			sameAs: [contact.githubUrl],
			url: pageUrl,
		},
		{
			"@id": `${pageUrl}#website`,
			"@type": "WebSite",
			description: site.description,
			inLanguage: "en",
			name: site.title,
			publisher: { "@id": `${pageUrl}#person` },
			url: pageUrl,
		},
		{
			"@id": `${pageUrl}#webpage`,
			"@type": "ProfilePage",
			about: { "@id": `${pageUrl}#person` },
			description: site.description,
			image: new URL(site.ogImage, siteUrl).toString(),
			inLanguage: "en",
			isPartOf: { "@id": `${pageUrl}#website` },
			name: site.title,
			primaryImageOfPage: new URL(site.ogImage, siteUrl).toString(),
			url: pageUrl,
		},
	],
};
---

<Layout jsonLd={jsonLd}>
	<HeroPreload slot="head" />
	<div class="site-frame" id="top" data-motion="reveal">
		<SiteHeader />
		<main class="shell" id="main">
			<HeroSection />
			<ProjectsSection />
			<AboutSection />
			<StackSection />
			<ContactSection />
		</main>
		<SiteFooter />
	</div>
</Layout>
