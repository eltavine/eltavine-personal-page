---
import Layout from "../layouts/Layout.astro";
import ContactSection from "../components/ContactSection.astro";
import HeroSection from "../components/HeroSection.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteScripts from "../components/SiteScripts.astro";
import StackSection from "../components/StackSection.astro";
import {
	contact,
	navigation,
	profile,
	projects,
	siteMeta,
	stackGroups,
} from "../data/site.js";

const year = new Date().getFullYear();
const siteUrl = Astro.site?.toString() ?? siteMeta.siteUrl;
const pageUrl = new URL("/", siteUrl).toString();
const imageUrl = new URL(siteMeta.image, siteUrl).toString();

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@id": `${pageUrl}#person`,
			"@type": "Person",
			description: profile.summary,
			image: new URL(profile.avatarUrl, siteUrl).toString(),
			jobTitle: profile.role,
			knowsAbout: [
				"Android security",
				"Native systems",
				"Backend systems",
				"Modular client architecture",
			],
			name: profile.name,
			sameAs: [contact.githubUrl],
			url: pageUrl,
		},
		{
			"@id": `${pageUrl}#website`,
			"@type": "WebSite",
			description: siteMeta.description,
			inLanguage: "en",
			name: siteMeta.title,
			publisher: { "@id": `${pageUrl}#person` },
			url: pageUrl,
		},
		{
			"@id": `${pageUrl}#webpage`,
			"@type": "ProfilePage",
			about: { "@id": `${pageUrl}#person` },
			description: siteMeta.description,
			image: imageUrl,
			inLanguage: "en",
			isPartOf: { "@id": `${pageUrl}#website` },
			name: siteMeta.title,
			primaryImageOfPage: imageUrl,
			url: pageUrl,
		},
	],
};
---

<Layout
	title={siteMeta.title}
	description={siteMeta.description}
	image={siteMeta.image}
	locale={siteMeta.locale}
	siteUrl={siteUrl}
	jsonLd={jsonLd}
>
	<div class="site-frame" id="top">
		<SiteHeader navigation={navigation} profile={profile} />

		<main class="shell">
			<HeroSection profile={profile} />
			<ProjectsSection projects={projects} />
			<StackSection stackGroups={stackGroups} />
			<ContactSection contact={contact} />
		</main>

		<SiteFooter
			contact={contact}
			navigation={navigation}
			profile={profile}
			year={year}
		/>
	</div>

	<SiteScripts />
</Layout>
