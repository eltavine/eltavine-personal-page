---
import { Font } from "astro:assets";
import { site } from "../config/site.ts";
import ThemeInit from "../features/theme/ThemeInit.astro";
import SoftInk from "../features/type/SoftInk.astro";
import CrayonDefs from "../ui/CrayonDefs.astro";
import "../styles/global.css";
import "../ui/ui.css";
import "../features/print/print.css";

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	image?: string;
	jsonLd?: unknown;
	noindex?: boolean;
}

const {
	canonicalPath = "/",
	description = site.description,
	image = site.ogImage,
	jsonLd,
	noindex = false,
	title = site.title,
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? site.url;
const pageTitle = title === site.title ? title : `${title} / ${site.title}`;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<!-- Must precede every bundled stylesheet: the first @layer seen fixes the cascade order. -->
		<style is:inline>
			@layer tokens, base, ui, features, overrides;
		</style>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<slot name="head" />
		<ThemeInit />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content={site.title} />
		<meta name="keywords" content="Eltavine, Android security, native systems, PGP" />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.title} />
		<meta property="og:locale" content={site.locale} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Eltavine: Android, Windows, native. A crayon portrait on graph paper."
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<!-- Glyph-subset files carry no subset name, so preload by family: both display styles and the body face. -->
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" />
		<Font cssVariable="--font-hand" />
		<SoftInk />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">
			Skip to content
		</a>
		<CrayonDefs />
		<slot />
		<script>
			import "../scripts/elements.ts";
			import "../scripts/boot.ts";
		</script>
	</body>
</html>
