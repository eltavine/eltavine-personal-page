---
import { contact, profile, sections, site } from "../../config/site.ts";
import { groupFingerprint } from "../../lib/format.ts";
import CrayonMark from "../../ui/CrayonMark.astro";
import Icon from "../../ui/Icon.astro";
import SectionHead from "../../ui/SectionHead.astro";
import Sparkle from "../../ui/Sparkle.astro";
import FingerprintSeal from "./FingerprintSeal.astro";
import ScratchReveal from "./ScratchReveal.astro";
import "./contact.css";

const year = new Date().getFullYear();
const host = new URL(site.url).host.toUpperCase();
const postmarkText = `${host} · ${year} · DIRECT · VERIFIABLE · QUIET ·`;
---

<section
	id="contact"
	class="section contact section-anchor"
	aria-labelledby="contact-title"
	data-motion="contact"
>
	<SectionHead copy={sections.contact} titleId="contact-title" />

	<p class="perforation" aria-hidden="true" data-reveal>
		<Icon name="lucide:scissors" class="perforation-icon" />
		<span class="hand">cut along the dotted line</span>
	</p>

	<postcard-flip class="postcard-scene" data-face="back" data-postcard>
		<div class="postcard">
			<article
				class="postcard-face postcard-face--back"
				aria-label="Contact details"
				data-postcard-face="back"
			>
				<p class="postcard-heading" aria-hidden="true">
					Post card
				</p>

				<div class="postcard-message">
					<p class="postcard-greeting hand" data-greeting>
						Say hi —
					</p>

					<dl class="postcard-lines">
						<div class="postcard-line" data-postcard-line>
							<dt>
								<Icon name="lucide:at-sign" class="postcard-label-icon" aria-hidden="true" />
								<span>Email</span>
							</dt>
							<dd>
								<ScratchReveal email={contact.emailParts} />
							</dd>
						</div>
						<div class="postcard-line" data-postcard-line>
							<dt>
								<Icon name="simple-icons:github" class="postcard-label-icon" aria-hidden="true" />
								<span>GitHub</span>
							</dt>
							<dd>
								<a class="text-link" href={contact.githubUrl} target="_blank" rel="noreferrer">
									<span>{contact.githubLabel}</span>
									<Icon name="lucide:arrow-up-right" class="postcard-link-icon" aria-hidden="true" />
								</a>
							</dd>
						</div>
					</dl>

					<div class="postcard-signature" data-postcard-line>
						<p class="postcard-sign hand">— {profile.name}</p>
						<FingerprintSeal class="postcard-seal" />
					</div>
				</div>

				<span class="postcard-divider" aria-hidden="true"></span>

				<div class="postcard-address">
					<div class="postcard-franking" aria-hidden="true">
						<div class="postmark" data-postmark>
							<CrayonMark kind="waves" seed={33} strokeWidth={2} draw class="postmark-waves" />
							<CrayonMark
								kind="circle"
								width={120}
								height={120}
								seed={31}
								strokeWidth={2.2}
								draw
								class="postmark-ring"
							/>
							<svg class="postmark-text" viewBox="0 0 120 120" data-postmark-text data-reveal>
								<defs>
									<path id="postmark-ring-path" d="M60 60m-41 0a41 41 0 1 1 82 0a41 41 0 1 1-82 0"></path>
								</defs>
								<text textLength="252" lengthAdjust="spacing">
									<textPath href="#postmark-ring-path">{postmarkText}</textPath>
								</text>
							</svg>
							<Sparkle class="postmark-sparkle" color="currentColor" size="1.4em" rotate={8} />
						</div>

						<div class="postage-stamp-wrap" data-postage data-reveal>
							<div class="postage-stamp">
								<img
									src={profile.avatar.src}
									srcset={profile.avatar.srcset}
									sizes="112px"
									width="160"
									height="160"
									alt=""
									loading="lazy"
									decoding="async"
								/>
								<p class="postage-stamp-meta">
									<span>{profile.name}</span>
									<strong>{contact.keyId.slice(-4)}</strong>
								</p>
							</div>
						</div>
					</div>

					<dl class="postcard-lines postcard-lines--address">
						<div class="postcard-line" data-postcard-line>
							<dt>
								<Icon name="lucide:key-round" class="postcard-label-icon" aria-hidden="true" />
								<span>PGP key</span>
							</dt>
							<dd class="postcard-key">{contact.keyId}</dd>
						</div>
						<div class="postcard-line" data-postcard-line>
							<dt>
								<Icon name="lucide:fingerprint" class="postcard-label-icon" aria-hidden="true" />
								<span>Fingerprint</span>
								<copy-button class="postcard-copy" data-copy={contact.fingerprint}>
									<button class="copy-button" type="button" hidden>
										<Icon name="lucide:copy" class="copy-icon" data-copy-icon="idle" aria-hidden="true" />
										<Icon name="lucide:check" class="copy-icon" data-copy-icon="done" aria-hidden="true" />
										<span data-copy-label>Copy</span>
										<span class="sr-only"> fingerprint</span>
									</button>
									<span class="sr-only" aria-live="polite" data-copy-status></span>
								</copy-button>
							</dt>
							<dd class="fingerprint" data-fingerprint aria-label={`Fingerprint ${contact.fingerprint}`}>
								{groupFingerprint(contact.fingerprint).map((group) => (
									<span>{group}</span>
								))}
							</dd>
						</div>
						<div class="postcard-line" data-postcard-line>
							<dt>
								<Icon name="lucide:file-key-2" class="postcard-label-icon" aria-hidden="true" />
								<span>Public key</span>
							</dt>
							<dd>
								<a class="text-link" href={contact.publicKeyUrl} download>
									<Icon name="lucide:download" class="postcard-link-icon" aria-hidden="true" />
									<span>Download .asc</span>
								</a>
							</dd>
						</div>
					</dl>
				</div>
			</article>

			<div class="postcard-face postcard-face--front" data-postcard-face="front" aria-hidden="true" inert>
				<p class="greetings-from hand">Greetings from</p>
				<p class="greetings-letters display">{profile.name}</p>
				<p class="greetings-sub">{new URL(site.url).host}</p>
				<p class="greetings-caption figure-caption">Fig. 05 — the picture side</p>
			</div>
		</div>

		<button class="postcard-turn" type="button" data-postcard-turn hidden>
			<Icon name="lucide:rotate-cw" class="postcard-turn-icon" aria-hidden="true" />
			<span data-postcard-turn-label>See the picture side</span>
		</button>
	</postcard-flip>
</section>
