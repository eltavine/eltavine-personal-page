---
import CrayonMark from "../../ui/CrayonMark.astro";

interface Props {
	text: string;
}

const { text } = Astro.props;
const anchor = `--note-${text.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<span class="note-anchor" style={`anchor-name: ${anchor};`}>
	<slot />
</span>
<span class="margin-note hand" style={`position-anchor: ${anchor};`} aria-hidden="true">
	<span>{text}</span>
	<CrayonMark
		kind="arrow"
		seed={37}
		width={40}
		height={24}
		strokeWidth={2}
		points={[
			[4, 12],
			[18, 6],
			[36, 12],
		]}
		class="margin-note-arrow"
	/>
</span>
