---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import sticker from "../assets/eltavine-sticker.png";
import CrayonMark from "./doodles/CrayonMark.astro";
import Sparkle from "./doodles/Sparkle.astro";

const { profile } = Astro.props;
const lastLine = profile.headlineLines.length - 1;

const sparkles = [
	{ color: "var(--crayon-marigold)", depth: 1.6, rotate: -8, size: "2.2rem", x: "2%", y: "24%" },
	{ color: "var(--crayon-blue)", depth: 2.3, rotate: 14, size: "1.15rem", x: "86%", y: "6%" },
	{ color: "var(--crayon-pink)", depth: 1.3, rotate: 22, size: "1.55rem", x: "95%", y: "58%" },
	{ color: "var(--crayon-lavender)", depth: 2.7, rotate: -18, size: "1rem", x: "14%", y: "86%" },
	{ color: "var(--crayon-sage)", depth: 1.9, rotate: 6, size: "0.85rem", x: "74%", y: "94%" },
];
---

<section class="hero" data-hero aria-labelledby="hero-title">
	<div class="graph-paper" aria-hidden="true"></div>

	<div class="hero-grid">
		<div class="hero-copy" data-hero-copy>
			<p class="eyebrow hero-eyebrow">
				<span class="eyebrow-index">00</span>
				<span class="eyebrow-rule" aria-hidden="true"></span>
				<span>{profile.role}</span>
			</p>

			<h1 id="hero-title" class="hero-title">
				{profile.headlineLines.map((line, index) => (
					<span class="hero-line" style={`--line: ${index}`}>
						<span class="hero-line-inner">
							{index === lastLine ? (
								<em class="marked">
									{line}
									<CrayonMark
										kind="underline"
										seed={11}
										width={300}
										height={34}
										strokeWidth={5}
										class="hero-mark"
									/>
								</em>
							) : (
								line
							)}
						</span>
					</span>
				))}
			</h1>

			<p class="hero-lead">{profile.lead}</p>
			<p class="hero-summary">{profile.summary}</p>

			<div class="hero-actions">
				<a class="button button-primary" href="#projects">
					<span>View projects</span>
					<Icon name="lucide:arrow-down-right" class="button-icon" aria-hidden="true" />
				</a>
				<a class="button button-secondary" href="#contact">
					<span>Get in touch</span>
					<Icon name="lucide:arrow-right" class="button-icon" aria-hidden="true" />
				</a>
			</div>

			<dl class="readout">
				<dt>{profile.readoutLabel}</dt>
				{profile.principles.map((principle, index) => (
					<dd style={`--dot: var(--crayon-${principle.crayon}); --i: ${index};`}>
						<span class="readout-dot" aria-hidden="true"></span>
						{principle.label}
					</dd>
				))}
			</dl>
		</div>

		<figure class="hero-figure">
			<div class="hero-stage">
				<span class="crop-marks" aria-hidden="true"><i></i><i></i><i></i><i></i></span>

				<div class="hero-sticker" data-hero-sticker data-depth="0.5">
					<div class="hero-sticker-drop">
						<Picture
							src={sticker}
							formats={["avif", "webp"]}
							widths={[280, 400, 569]}
							sizes="(min-width: 1080px) 380px, (min-width: 560px) 300px, 62vw"
							alt="A hand-drawn crayon portrait of Eltavine holding a red heart"
							class="sticker hero-sticker-img"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
				</div>

				{sparkles.map((sparkle, index) => (
					<span
						class="hero-sparkle"
						data-depth={sparkle.depth}
						style={`--x: ${sparkle.x}; --y: ${sparkle.y}; --i: ${index};`}
						aria-hidden="true"
					>
						<span class="hero-sparkle-float" data-hero-sparkle>
							<Sparkle color={sparkle.color} size={sparkle.size} rotate={sparkle.rotate} />
						</span>
					</span>
				))}

				<p class="hero-note hand" data-depth="0.9" aria-hidden="true">
					<span>{profile.handNote}</span>
					<CrayonMark kind="arrow" seed={4} strokeWidth={2.4} class="hero-note-arrow" />
				</p>
			</div>
			<figcaption class="hero-caption">{profile.figureCaption}</figcaption>
		</figure>
	</div>

	<a class="scroll-cue" href="#projects" aria-label="Scroll to projects">
		<span class="hand">scroll</span>
		<CrayonMark
			kind="arrow"
			seed={9}
			width={34}
			height={70}
			strokeWidth={2.2}
			points={[
				[14, 4],
				[20, 24],
				[13, 44],
				[17, 64],
			]}
			class="scroll-cue-arrow"
		/>
	</a>
</section>
