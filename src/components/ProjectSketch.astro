---
import rough from "roughjs";

type Point = [number, number];

interface Props {
	sketch: {
		caption: string;
		description: string;
		height: number;
		items: Record<string, any>[];
	};
	seed?: number;
}

const { sketch, seed = 1 } = Astro.props;
const width = 340;
const outline = "#010101";
const hatch = "#020202";
const generator = rough.generator();
const base = { bowing: 0.7, roughness: 0.85, stroke: outline, strokeWidth: 1.25 };
const hatchFill = { fill: hatch, fillStyle: "hachure", fillWeight: 1.3, hachureAngle: -41, hachureGap: 5 };

let seedCounter = seed * 100;
const nextSeed = () => ++seedCounter;

const roundPath = (d: string) => d.replace(/-?\d*\.\d+/g, (value) => String(Math.round(Number(value))));

type SketchPath = { d: string; kind: "stroke" | "fill" | "dashed"; accent: boolean; width: number };
type SketchText = { x: number; y: number; text: string; kind: string; anchor: string; onFill?: boolean };

const paths: SketchPath[] = [];
const texts: SketchText[] = [];

function add(drawable: ReturnType<typeof generator.line>, { accent = false, dashed = false } = {}) {
	for (const info of generator.toPaths(drawable)) {
		const isFill = info.stroke === hatch;
		paths.push({
			accent: accent || isFill,
			d: roundPath(info.d),
			kind: isFill ? "fill" : dashed ? "dashed" : "stroke",
			width: info.strokeWidth,
		});
	}
}

function arrowHead([px, py]: Point, [ex, ey]: Point, size = 7): Point[] {
	const angle = Math.atan2(ey - py, ex - px);
	return [
		[ex - size * Math.cos(angle - 0.5), ey - size * Math.sin(angle - 0.5)],
		[ex, ey],
		[ex - size * Math.cos(angle + 0.5), ey - size * Math.sin(angle + 0.5)],
	];
}

function roundedRect(x: number, y: number, w: number, h: number, r: number) {
	return `M${x + r} ${y}H${x + w - r}Q${x + w} ${y} ${x + w} ${y + r}V${y + h - r}Q${x + w} ${y + h} ${x + w - r} ${y + h}H${x + r}Q${x} ${y + h} ${x} ${y + h - r}V${y + r}Q${x} ${y} ${x + r} ${y}Z`;
}

function labelBox(item: Record<string, any>) {
	const cx = item.x + item.w / 2;
	const cy = item.y + item.h / 2;
	const onFill = Boolean(item.fill);
	if (item.sub) {
		texts.push({ anchor: "middle", kind: "label", onFill, text: item.label, x: cx, y: cy - 2 });
		texts.push({ anchor: "middle", kind: "sub", onFill, text: item.sub, x: cx, y: cy + 13 });
	} else {
		texts.push({ anchor: "middle", kind: "label", onFill, text: item.label, x: cx, y: cy + 4.5 });
	}
}

for (const item of sketch.items) {
	switch (item.type) {
		case "box":
			add(
				generator.rectangle(item.x, item.y, item.w, item.h, {
					...base,
					...(item.fill ? hatchFill : {}),
					seed: nextSeed(),
				}),
			);
			labelBox(item);
			break;
		case "frame":
			add(
				generator.path(roundedRect(item.x, item.y, item.w, item.h, item.r), {
					...base,
					disableMultiStroke: Boolean(item.dashed),
					seed: nextSeed(),
				}),
				{ dashed: item.dashed },
			);
			break;
		case "phone":
			add(
				generator.path(roundedRect(item.x, item.y, item.w, item.h, 4), {
					...base,
					...(item.fill ? hatchFill : {}),
					seed: nextSeed(),
				}),
			);
			add(
				generator.line(item.x + item.w * 0.36, item.y + 5, item.x + item.w * 0.64, item.y + 5, {
					...base,
					disableMultiStroke: true,
					seed: nextSeed(),
				}),
			);
			break;
		case "check":
			add(generator.rectangle(item.x, item.y, 9, 9, { ...base, roughness: 0.6, seed: nextSeed() }));
			add(
				generator.linearPath(
					[
						[item.x + 1.5, item.y + 4],
						[item.x + 4, item.y + 8],
						[item.x + 11, item.y - 2],
					],
					{ ...base, disableMultiStroke: true, seed: nextSeed(), strokeWidth: 1.5 },
				),
				{ accent: true },
			);
			break;
		case "brace": {
			const mid = (item.y1 + item.y2) / 2;
			const { x } = item;
			add(
				generator.path(
					`M${x} ${item.y1}Q${x + 5} ${item.y1} ${x + 5} ${item.y1 + 8}V${mid - 8}Q${x + 5} ${mid} ${x + 10} ${mid}Q${x + 5} ${mid} ${x + 5} ${mid + 8}V${item.y2 - 8}Q${x + 5} ${item.y2} ${x} ${item.y2}`,
					{ ...base, disableMultiStroke: true, roughness: 0.6, seed: nextSeed() },
				),
			);
			break;
		}
		case "line":
			add(
				generator.linearPath(item.points, { ...base, disableMultiStroke: Boolean(item.dashed), seed: nextSeed() }),
				{ dashed: item.dashed },
			);
			break;
		case "arrow": {
			const points: Point[] = item.points;
			const options = { ...base, disableMultiStroke: Boolean(item.dashed), seed: nextSeed() };
			const style = { accent: item.accent, dashed: item.dashed };
			add(points.length > 2 ? generator.curve(points, options) : generator.linearPath(points, options), style);
			add(
				generator.linearPath(arrowHead(points[points.length - 2], points[points.length - 1]), {
					...base,
					disableMultiStroke: true,
					seed: nextSeed(),
				}),
				{ accent: item.accent },
			);
			break;
		}
		case "text":
			texts.push({
				anchor: item.anchor ?? "start",
				kind: item.kind,
				text: item.kind === "small" ? item.text.toUpperCase() : item.text,
				x: item.x,
				y: item.y,
			});
			break;
	}
}
---

<figure class="sheet-sketch" data-sketch>
	<span class="crop-marks" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
	<svg
		class="sketch"
		viewBox={`-4 -4 ${width + 8} ${sketch.height + 8}`}
		role="img"
		aria-label={sketch.description}
	>
		<g class="sketch-lines" fill="none" stroke-linecap="round" stroke-linejoin="round">
			{paths.map((path) => (
				<path
					class:list={[`sketch-${path.kind}`, { "is-accent": path.accent }]}
					d={path.d}
					stroke="currentColor"
					stroke-width={path.width}
					pathLength={path.kind === "dashed" ? undefined : "1"}
				/>
			))}
		</g>
		<g class="sketch-labels">
			{texts.map((text) => (
				<text
					class:list={["sketch-text", `sketch-text--${text.kind}`, { "is-on-fill": text.onFill }]}
					x={text.x}
					y={text.y}
					text-anchor={text.anchor}
				>
					{text.text}
				</text>
			))}
		</g>
	</svg>
	<figcaption>{sketch.caption}</figcaption>
</figure>
