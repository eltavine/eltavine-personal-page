---
import { Icon } from "astro-icon/components";
import CrayonMark from "./doodles/CrayonMark.astro";

const { navigation, profile } = Astro.props;
---

<header class="site-header" data-site-header>
	<div class="shell site-header-inner">
		<a class="brand" href="#top" aria-label="Eltavine home">
			<img
				class="brand-mark"
				src={profile.avatarUrl}
				srcset={profile.avatarSrcset}
				sizes="40px"
				width="160"
				height="160"
				alt=""
				decoding="async"
			/>
			<span class="brand-name">{profile.name}</span>
		</a>

		<div class="nav-pill">
			<nav class="site-nav" aria-label="Primary navigation">
				{navigation.map((item, index) => (
					<a class="nav-link" href={item.href} data-nav-link>
						<span class="nav-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
						<span>{item.label}</span>
						<CrayonMark
							kind="underline"
							seed={21 + index}
							width={120}
							height={16}
							strokeWidth={2.6}
							class="nav-mark"
						/>
					</a>
				))}
			</nav>
			<span class="nav-divider" aria-hidden="true"></span>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme">
				<Icon name="lucide:sun" class="theme-icon theme-icon-sun" aria-hidden="true" />
				<Icon name="lucide:moon" class="theme-icon theme-icon-moon" aria-hidden="true" />
			</button>
		</div>
	</div>
</header>
