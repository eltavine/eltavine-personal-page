---
import CrayonMark from "./doodles/CrayonMark.astro";
import Sparkle from "./doodles/Sparkle.astro";
import SectionHead from "./SectionHead.astro";

const { about, projects } = Astro.props;
const pad = (value) => String(value).padStart(2, "0");
const bench = about.bench
	.map((id) => {
		const index = projects.findIndex((project) => project.id === id);
		return index === -1 ? null : { ...projects[index], number: pad(index + 1) };
	})
	.filter(Boolean);
---

<section id="about" class="section about section-anchor" aria-labelledby="about-title">
	<SectionHead
		index="02"
		label="About"
		titleId="about-title"
		before="Notes on "
		marked="how I work"
		after="."
		markSeed={27}
		lead={about.lead}
	/>

	<div class="notebook" data-notebook data-reveal>
		<div class="notebook-page notebook-page--ruled" data-notebook-page>
			<p class="notebook-greeting hand" data-notebook-greeting>{about.greeting}</p>
			{about.paragraphs.map((paragraph) => (
				<p class="notebook-copy" data-notebook-line>{paragraph}</p>
			))}
			<p class="notebook-note hand" aria-hidden="true" data-notebook-line>
				<span>{about.marginNote}</span>
				<CrayonMark
					kind="arrow"
					seed={29}
					width={34}
					height={52}
					strokeWidth={2.2}
					points={[
						[8, 48],
						[20, 32],
						[16, 16],
						[24, 4],
					]}
					draw
					class="notebook-note-arrow"
				/>
			</p>
			<Sparkle class="notebook-sparkle" color="var(--crayon-pink)" size="1.2rem" rotate={16} />
		</div>

		<span class="notebook-crease" aria-hidden="true"></span>

		<div class="notebook-page notebook-page--grid" data-notebook-page>
			<h3 class="notebook-kicker">Working rules</h3>
			<ol class="rules">
				{about.rules.map((rule, index) => (
					<li
						class="rule"
						data-rule
						style={`--rule-color: var(--crayon-${rule.crayon}); --rule-ink: var(--crayon-${rule.crayon}-ink);`}
					>
						<span class="rule-box" aria-hidden="true">
							<CrayonMark kind="box" seed={71 + index} width={36} height={36} strokeWidth={1.8} class="rule-frame" />
							<CrayonMark kind="check" seed={75 + index} width={36} height={30} strokeWidth={3.2} draw class="rule-check" />
						</span>
						<p class="rule-title">
							<span class="rule-number">{pad(index + 1)}</span>
							<strong>{rule.title}</strong>
						</p>
						<p class="rule-body">{rule.body}</p>
					</li>
				))}
			</ol>

			{bench.length > 0 && (
				<div class="bench" data-notebook-line>
					<p class="bench-label" id="bench-label">On the bench</p>
					<ul class="bench-list" aria-labelledby="bench-label">
						{bench.map((project) => (
							<li>
								<a
									href={`#project-${project.id}`}
									style={`--bench-color: var(--crayon-${project.crayon}); --bench-ink: var(--crayon-${project.crayon}-ink);`}
								>
									<span class="bench-dot" aria-hidden="true"></span>
									<span class="bench-number" aria-hidden="true">{project.number}</span>
									<span>{project.title}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			)}
		</div>
	</div>
</section>
