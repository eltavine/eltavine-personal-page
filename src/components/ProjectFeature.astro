---
import { Icon } from "astro-icon/components";
import StarHistoryEmbed from "./StarHistoryEmbed.astro";

const { project } = Astro.props;
---

<article class="project-feature">
	<div class="project-meta" aria-label="Project metadata">
		<span>
			<Icon name={project.icon} class="meta-icon" aria-hidden="true" />
			{project.section}
		</span>
		<span>{project.status}</span>
	</div>

	<div class="project-grid">
		<div class="project-main">
			<h3>{project.title}</h3>
			<p class="project-summary">{project.summary}</p>
			<p class="project-emphasis">{project.emphasis}</p>

			<StarHistoryEmbed project={project} />

			{project.github && (
				<a
					class="github-repo-stats"
					href={project.github.href}
					target="_blank"
					rel="noreferrer"
					data-github-repo-stats
					data-repo={project.github.repo}
					data-state="loading"
					aria-label={`Open ${project.title} on GitHub`}
				>
					<Icon
						name="simple-icons:github"
						class="repo-stats-icon repo-stats-icon-github"
						aria-hidden="true"
					/>
					<Icon
						name="lucide:wifi-off"
						class="repo-stats-icon repo-stats-icon-network"
						aria-hidden="true"
					/>
					<span class="repo-stats-values" data-github-values>
						<span class="repo-stat">
							<strong data-github-stars>--</strong>
							<span>Stars</span>
						</span>
						<span class="repo-stat">
							<strong data-github-forks>--</strong>
							<span>Forks</span>
						</span>
					</span>
					<span class="repo-network-status" data-github-network-status>
						Network Unavailable
					</span>
				</a>
			)}

			{project.availability && (
				<p class:list={[
					"project-availability",
					`project-availability--${project.availability.kind ?? "default"}`,
				]}>
					<Icon name={project.availability.icon} class="availability-icon" aria-hidden="true" />
					<span>{project.availability.label}</span>
				</p>
			)}

			<ul class="tag-list" aria-label={`${project.title} stack`}>
				{project.stack.map((item) => (
					<li>
						<Icon name={item.icon} class="tag-icon" aria-hidden="true" />
						<span>{item.label}</span>
					</li>
				))}
			</ul>
		</div>

		<ol class="project-notes">
			{project.notes.map((note) => <li>{note}</li>)}
		</ol>
	</div>
</article>
