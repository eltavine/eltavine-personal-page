---
import { Icon } from "astro-icon/components";
import { sketches } from "../data/sketches.js";
import ProjectSketch from "./ProjectSketch.astro";
import StarHistoryEmbed from "./StarHistoryEmbed.astro";

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
const sketch = sketches[project.id];
const kind = project.availability?.kind === "public" ? "public" : "internal";
const titleId = `project-${project.id}-title`;
---

<article
	class="project-sheet"
	id={`project-${project.id}`}
	aria-labelledby={titleId}
	data-project-sheet
	data-project-id={project.id}
	data-crayon={project.crayon}
	data-reveal
	style={`--sheet-color: var(--crayon-${project.crayon}); --sheet-ink: var(--crayon-${project.crayon}-ink);`}
>
	<header class="sheet-head">
		<p class="sheet-tab">
			<Icon name={project.icon} class="sheet-tab-icon" aria-hidden="true" />
			<span>{project.section}</span>
		</p>
		{project.availability && (
			<p class:list={["stamp", `stamp--${kind}`]} data-stamp>
				<Icon name={project.availability.icon} class="stamp-icon" aria-hidden="true" />
				<span>{kind === "public" ? "Public" : "Internal"}</span>
			</p>
		)}
	</header>

	<div class="sheet-hero">
		<span class="sheet-number" data-sheet-number aria-hidden="true">{number}</span>
		<h3 id={titleId} class="sheet-title" data-sheet-title>{project.title}</h3>
		<p class="sheet-summary">{project.summary}</p>
		<div class="sheet-doodle" data-doodle aria-hidden="true">
			<Icon name={project.icon} is:inline class="sheet-doodle-icon" />
		</div>
	</div>

	<div class="sheet-body">
		<div class="sheet-main">
			<p class="sheet-emphasis" data-sheet-item>{project.emphasis}</p>

			<dl class="spec-table">
				<div class="spec-row" data-sheet-item>
					<dt>Status</dt>
					<dd>{project.status}</dd>
				</div>
				<div class="spec-row" data-sheet-item>
					<dt>Stack</dt>
					<dd>
						<ul class="spec-stack" aria-label={`${project.title} stack`}>
							{project.stack.map((item) => (
								<li>
									<Icon name={item.icon} class="spec-stack-icon" aria-hidden="true" />
									<span>{item.label}</span>
								</li>
							))}
						</ul>
						<a class="spec-map-link" href="#stack" data-stack-focus={project.id}>
							<span>Highlight in stack</span>
							<Icon name="lucide:arrow-down-right" class="spec-map-icon" aria-hidden="true" />
						</a>
					</dd>
				</div>
				{project.github && (
					<div class="spec-row" data-sheet-item>
						<dt>Source</dt>
						<dd>
							<a
								class="repo-link"
								href={project.github.href}
								target="_blank"
								rel="noreferrer"
								data-github-repo-stats
								data-repo={project.github.repo}
								data-state="loading"
								aria-label={`Open ${project.title} on GitHub`}
							>
								<Icon name="simple-icons:github" class="repo-icon" aria-hidden="true" />
								<span class="repo-name">{project.github.repo}</span>
								<span class="repo-stats">
									<span class="repo-stat">
										<Icon name="lucide:star" class="repo-stat-icon" aria-hidden="true" />
										<strong data-github-stars>--</strong>
										<span class="sr-only">stars</span>
									</span>
									<span class="repo-stat">
										<Icon name="lucide:git-fork" class="repo-stat-icon" aria-hidden="true" />
										<strong data-github-forks>--</strong>
										<span class="sr-only">forks</span>
									</span>
								</span>
								<span class="repo-network-status">
									<Icon name="lucide:wifi-off" class="repo-stat-icon" aria-hidden="true" />
									Network unavailable
								</span>
							</a>
						</dd>
					</div>
				)}
			</dl>

			<StarHistoryEmbed project={project} />
		</div>

		<div class="sheet-side">
			{sketch && <ProjectSketch sketch={sketch} seed={index + 1} />}
			<ol class="sheet-notes" aria-label={`${project.title} highlights`}>
				{project.notes.map((note) => <li data-sheet-note>{note}</li>)}
			</ol>
		</div>
	</div>
</article>
