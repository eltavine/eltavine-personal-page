---
const { project } = Astro.props;
const { starHistory } = project;
const alt = `${project.title} star history chart`;
---

{starHistory && (
	<figure class="taped-photo" data-photo>
		<span class="tape tape--left" aria-hidden="true"></span>
		<span class="tape tape--right" aria-hidden="true"></span>
		<a
			href={starHistory.href}
			target="_blank"
			rel="noreferrer"
			aria-label={`Open ${project.title} star history on Star History`}
		>
			<img
				class="star-chart star-chart--light"
				src={starHistory.lightSrc}
				alt={alt}
				width="800"
				height="533"
				loading="lazy"
				decoding="async"
			/>
			<img
				class="star-chart star-chart--dark"
				src={starHistory.darkSrc}
				alt={alt}
				width="800"
				height="533"
				loading="lazy"
				decoding="async"
			/>
		</a>
		<figcaption>Star history / {project.github?.repo ?? project.title}</figcaption>
	</figure>
)}
